{
  "permissions": {
    "allow": [
      "Read(//home/harthik/FacadeBot_control/**)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(python3 -m pytest *)",
      "Bash(colcon build *)",
      "Bash(ros2 interface *)",
      "Bash(ros2 node list)",
      "Bash(ros2 topic list)",
      "Bash(ros2 service list)",
      "Bash(ros2 action list)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git push)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-git-commit-push.sh",
            "timeout": 10,
            "statusMessage": "Checking for git commit/push"
          }
        ]
      }
    ]
  }
}
